# Go API URL. Server-side only; do not place participant tokens here.
TRACE_BACKEND_URL=http://127.0.0.1:8080

# Participant API defaults to this same-origin route, even when unset or empty.
# NEXT_PUBLIC_TRACE_API_URL=/api/backend
# dev:local builds a sibling backend and keeps its PostgreSQL data locally.
# TRACE_BACKEND_REPO=../trace_Backend
# TRACE_LOCAL_DATA_DIR=.local

# Optional real /display connections. Credentials remain in tab memory, never here.
# NEXT_PUBLIC_DISPLAY_API_URL=https://YOUR-TRACE-B-RENDERER-ORIGIN
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=768829535838-9v4875nkjopo91uobrmggneqodmvec85.apps.googleusercontent.com
# NEXT_PUBLIC_ARRIVAL_ISSUER_URL=http://127.0.0.1:8790
# NEXT_PUBLIC_ARRIVAL_VENUE=GO-CONFIGURED-VENUE
# NEXT_PUBLIC_ARRIVAL_CHECKPOINT_ID=GO-CONFIGURED-CHECKPOINT
# NEXT_PUBLIC_ARRIVAL_PROOF_KEY_ID=arrival-proof-v1
