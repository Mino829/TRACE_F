// Serves the static export of the web app (../out, from `NEXT_STATIC_EXPORT=1 next build`).
// Static assets plus same-origin Go API bridge. No cron here, unlike wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-production",
  "main": "src/site.ts",
  "compatibility_date": "2026-09-01",
  // TRACE_BACKEND_URL is a plain variable set on the dashboard for trace-production; without this a deploy deletes it and /api/backend goes 503.
  "keep_vars": true,
  // Explicitly none: an earlier mistaken deploy left trace-log, this worker's old name, with a cron.
  "triggers": { "crons": [] },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/backend/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
