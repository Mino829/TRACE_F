// Serves the static export of the web app (../out, from `NEXT_STATIC_EXPORT=1 next build`).
// Static assets plus same-origin Go API bridge. No cron here, unlike wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-log",
  "main": "src/site.ts",
  "compatibility_date": "2026-09-01",
  // Explicitly none: an earlier mistaken deploy left this name with a cron.
  "triggers": { "crons": [] },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/backend/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
