// Legacy trace-log only; never used by production CI or scripts/production.mjs.
// Manual deployment mutates the existing rehearsal Worker and requires separate authorization.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-log",
  "main": "src/site.ts",
  "compatibility_date": "2026-09-01",
  // Static/API bridge only. Keep the legacy Worker free of scheduled triggers.
  "triggers": { "crons": [] },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/backend/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
